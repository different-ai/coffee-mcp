{
  "name": "coffee-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "coffee.openworklabs.com/sf: an MCP server (with an MCP App) that books a coffee with the OpenWork team.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build:app": "vite build",
    "dev": "pnpm build:app && wrangler dev",
    "test": "pnpm build:app && vitest run",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "deploy": "pnpm build:app && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}

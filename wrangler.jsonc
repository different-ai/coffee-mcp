{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffee-mcp",
  "account_id": "5abbcca46f2a1399566cab3a8f8bd2c6", // OpenWork Labs (owns the openworklabs.com zone)
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The built MCP App (dist/app.html) is imported by the Worker as a string.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  // Reuse the production namespace; never accidentally create a new booking store.
  "kv_namespaces": [{ "binding": "COFFEE_KV", "id": "a5ec05fff0194ce6885c68d879f6748b" }],
  // Cloudflare Email Service; coffee.openworklabs.com is onboarded for sending.
  "send_email": [{ "name": "EMAIL" }],
  "routes": [{ "pattern": "coffee.openworklabs.com", "custom_domain": true }],
  "vars": {
    "PUBLIC_URL": "https://coffee.openworklabs.com",
    "CITY": "sf",
    "TIMEZONE": "America/Los_Angeles",
    "HOST_NAME": "the OpenWork team",
    "COFFEE_PLACE": "OpenWork · 700 Alabama St, San Francisco",
    "COFFEE_PLACE_URL": "https://maps.google.com/?q=700+Alabama+St+San+Francisco",
    "EMAIL_FROM": "OpenWork Coffee <hello@coffee.openworklabs.com>"
  }
  // Secrets (wrangler secret put ...):
  //   RESEND_API_KEY      optional fallback if the EMAIL binding is removed
  //   SLACK_WEBHOOK_URL   incoming webhook for #coffee-requests
  //   or SLACK_BOT_TOKEN + SLACK_CHANNEL_ID (chat.postMessage)
  //   HOST_EMAIL          optional, CC'd on every invite
}

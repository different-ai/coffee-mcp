{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coffee-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The built MCP App (dist/app.html) is imported by the Worker as a string.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  // No id: Wrangler provisions the namespace on first deploy.
  "kv_namespaces": [{ "binding": "COFFEE_KV" }],
  "routes": [{ "pattern": "coffee.openworklabs.com", "custom_domain": true }],
  "vars": {
    "PUBLIC_URL": "https://coffee.openworklabs.com",
    "CITY": "sf",
    "TIMEZONE": "America/Los_Angeles",
    "HOST_NAME": "the OpenWork team",
    "COFFEE_PLACE": "Sightglass Coffee, 270 7th St, San Francisco",
    "COFFEE_PLACE_URL": "https://maps.google.com/?q=Sightglass+Coffee+270+7th+St+San+Francisco",
    "EMAIL_FROM": "OpenWork Coffee <coffee@openworklabs.com>"
  }
  // Secrets (wrangler secret put ...):
  //   RESEND_API_KEY      sends the confirmation + invite emails
  //   SLACK_WEBHOOK_URL   incoming webhook for #coffee-requests
  //   or SLACK_BOT_TOKEN + SLACK_CHANNEL_ID (chat.postMessage)
  //   HOST_EMAIL          optional, CC'd on every invite
}
